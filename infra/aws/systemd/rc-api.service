# Rendered by Terraform into /etc/systemd/system/rc-api.service.
# Every secret arrives as a file or through the 0600 EnvironmentFile, never on the
# command line, because the command line is readable by every local user in ps.
# -insecure-http is what makes rc-api serve plaintext on loopback for Caddy to terminate;
# it does not enable the API.md §6.3 development calls, which are gated on -idp dev.

[Unit]
Description=SkipperDesk REST API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${service_user}
Group=${service_user}
EnvironmentFile=${config_dir}/rc-api.env
ExecStart=${app_dir}/bin/rc-api \
  -insecure-http \
  -listen ${api_listen} \
  -internal-listen ${api_internal_listen} \
  -db ${data_dir}/rc-api.db \
  -claims-db ${data_dir}/rc-api-claims.db \
  -internal-token-file ${data_dir}/internal-token \
  -id-cert-key-file ${data_dir}/id-cert-key.pem \
  -idp cognito \
  -cognito-issuer ${cognito_issuer} \
  -cognito-audience ${cognito_audience} \
  -web-base-url ${web_base_url} \
  -signal-upstream http://${signal_listen} \
  -signal-internal-url http://${signal_internal_listen} \
  -trusted-proxies ${trusted_proxies} \
  -log-level info
StandardOutput=append:${log_dir}/rc-api.log
StandardError=append:${log_dir}/rc-api.log
Restart=always
RestartSec=5
TimeoutStopSec=15

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=${data_dir} ${log_dir}

[Install]
WantedBy=multi-user.target
