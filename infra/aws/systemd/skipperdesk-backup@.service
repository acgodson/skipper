# One template unit for both databases: %i is db or claims.

[Unit]
Description=SkipperDesk SQLite snapshot to S3 (%i)
After=network-online.target rc-api.service
Wants=network-online.target

# Both databases are on the data volume, and rc-api is what creates them. Without the
# mount this would see an empty directory and fail; ordering after rc-api keeps a boot
# from spending its first attempt on a file that does not exist yet. Neither is a
# Requires: a backup must still run when rc-api is down, because the data is still there.
RequiresMountsFor=${data_dir}

[Service]
Type=oneshot
User=${service_user}
Group=${service_user}
EnvironmentFile=${config_dir}/backup.env
ExecStart=${app_dir}/bin/backup.sh %i
StandardOutput=append:${log_dir}/backup.log
StandardError=append:${log_dir}/backup.log

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=${log_dir} ${data_dir}
